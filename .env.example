# HOMADOS AI / VoiceGuardAI environment
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=HOMADOS AI
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated browser origins allowed to call the API.
# Use * for public demo. For production, set your Vercel/Netlify URL.
CORS_ORIGINS=*

# Public URL of this API (used in OpenAPI and health payload)
PUBLIC_API_URL=https://your-api.onrender.com

# Frontend origin after deploy (documentation / redirects)
PUBLIC_FRONTEND_URL=https://your-app.vercel.app

# Model loading
ENABLE_ECAPA=true
ENABLE_AASIST=true
ECAPA_SOURCE=speechbrain/spkrec-ecapa-voxceleb
ECAPA_SAVEDIR=models/ecapa_tdnn
AASIST_SAVEDIR=models/aasist
TORCH_DEVICE=cpu

# Risk fusion
RISK_SPOOF_WEIGHT=0.55
RISK_IDENTITY_WEIGHT=0.30
RISK_SPECTRAL_WEIGHT=0.15
ALERT_SOFT_THRESHOLD=45
ALERT_HARD_THRESHOLD=75
